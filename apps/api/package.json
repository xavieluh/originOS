{
  "name": "@originos/api",
  "version": "0.0.0",
  "private": true,
  "description": "OriginOS modular-monolith API (NestJS on Fastify).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "@better-auth/passkey": "1.7.27",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-fastify": "12.6.0",
    "@originos/config": "workspace:*",
    "@originos/contracts": "workspace:*",
    "@originos/db": "workspace:*",
    "@originos/service-kit": "workspace:*",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nodemailer": "10.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
