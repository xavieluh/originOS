{
  "name": "@originos/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: outbox dispatch and durable jobs. Scaffold only: queue arrives in Phase 07.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@originos/config": "workspace:*",
    "@originos/db": "workspace:*",
    "@originos/service-kit": "workspace:*",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@originos/contracts": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
