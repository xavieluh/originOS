{
  "name": "originos",
  "private": true,
  "description": "OriginOS monorepo. See README.md and docs/MASTER_SPEC.md.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @originos/db seed",
    "test:integration": "pnpm --workspace-concurrency=1 --filter @originos/db --filter @originos/storage --filter @originos/api --filter @originos/worker test:integration",
    "db:migrate": "pnpm --filter @originos/db migrate",
    "db:status": "pnpm --silent --filter @originos/db status",
    "storage:setup": "pnpm --silent --filter @originos/storage run setup"
  },
  "devDependencies": {
    "@originos/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
