{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "LOG_LEVEL",
        "DATABASE_URL",
        "ORIGINOS_API_URL",
        "ORIGINOS_VERSION",
        "API_PORT",
        "API_HOST",
        "WORKER_HEALTH_PORT",
        "WORKER_HEALTH_HOST",
        "MCP_PORT",
        "MCP_HOST",
        "TELEMETRY_PORT",
        "TELEMETRY_HOST",
        "MEDIA_VALIDATOR_PORT",
        "MEDIA_VALIDATOR_HOST",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "AI_GATEWAY_URL",
        "ORIGINOS_ENABLE_GALLERY"
      ]
    }
  }
}
