# OriginOS local development environment. Copy to .env and adjust.
# Never commit real credentials. Every variable is validated at startup;
# validation errors name the variable but never print its value.

NODE_ENV=development
LOG_LEVEL=info

# apps/api
API_PORT=4000
API_HOST=127.0.0.1
# Optional in development; required when NODE_ENV=production.
# DATABASE_URL=postgres://originos:originos@127.0.0.1:5432/originos

# apps/web (server-side only; never exposed to the browser)
ORIGINOS_API_URL=http://127.0.0.1:4000

# apps/mcp-server
MCP_PORT=4100
MCP_HOST=127.0.0.1

# services/telemetry
TELEMETRY_PORT=4200
TELEMETRY_HOST=127.0.0.1

# services/media-validator
MEDIA_VALIDATOR_PORT=4300
MEDIA_VALIDATOR_HOST=127.0.0.1
