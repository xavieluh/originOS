# OriginOS local development environment.
#
#   cp .env.example .env      (scripts/bootstrap.sh does this for you)
#
# Rules (docs/SECRETS.md):
# - .env and .env.* are git-ignored; only this example file is committed.
# - Values here are LOCAL-ONLY placeholders that match compose.yaml. They are
#   not secrets and must never be reused outside a developer machine.
# - Real credentials (provider API keys, OAuth secrets, signing keys) never go
#   in this file or in any committed file. Later phases document where each
#   one lives (secret manager / KMS) when it is introduced.
# - Every variable is validated at startup. Validation errors name the variable
#   but never print its value, and logs redact credential fields.
# - Empty values count as "not set".

# --- Shared ---------------------------------------------------------------
# development | test | production. production makes DATABASE_URL mandatory.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (compose service "postgres", pgvector enabled) -------------
# Used by apps/api and apps/worker only. Optional in development: without it,
# readiness reports the database as "not_configured".
DATABASE_URL=postgres://originos:originos-local-only@127.0.0.1:5432/originos
# Separate database for tests that write data (created by infra/local/postgres-init).
TEST_DATABASE_URL=postgres://originos:originos-local-only@127.0.0.1:5432/originos_test

# --- Object storage (compose service "object-storage", S3-compatible) ----
# Not read by any code until Phase 07 (ingestion). Listed so the emulator's
# local credentials are documented in one place.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=originos-local-access-key
S3_SECRET_ACCESS_KEY=originos-local-only-secret

# --- apps/api ------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1

# --- apps/web (server-side only; never sent to the browser) --------------
ORIGINOS_API_URL=http://127.0.0.1:4000

# --- apps/worker (health endpoint only) ----------------------------------
WORKER_HEALTH_PORT=4050
WORKER_HEALTH_HOST=127.0.0.1

# --- apps/mcp-server -----------------------------------------------------
MCP_PORT=4100
MCP_HOST=127.0.0.1

# --- services/telemetry --------------------------------------------------
TELEMETRY_PORT=4200
TELEMETRY_HOST=127.0.0.1

# --- services/media-validator --------------------------------------------
MEDIA_VALIDATOR_PORT=4300
MEDIA_VALIDATOR_HOST=127.0.0.1

# --- services/ai-worker (Python) -----------------------------------------
# AI gateway endpoint on the API; it does not exist until Phase 15.
# AI_GATEWAY_URL=
