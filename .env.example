# OriginOS local development environment.
#
#   cp .env.example .env      (scripts/bootstrap.sh does this for you)
#
# Rules (docs/SECRETS.md):
# - .env and .env.* are git-ignored; only this example file is committed.
# - Values here are LOCAL-ONLY placeholders that match compose.yaml. They are
#   not secrets and must never be reused outside a developer machine.
# - Real credentials (provider API keys, OAuth secrets, signing keys) never go
#   in this file or in any committed file. Later phases document where each
#   one lives (secret manager / KMS) when it is introduced.
# - Every variable is validated at startup. Validation errors name the variable
#   but never print its value, and logs redact credential fields.
# - Empty values count as "not set".

# --- Shared ---------------------------------------------------------------
# development | test | production. production makes DATABASE_URL mandatory.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (compose service "postgres", pgvector enabled) -------------
# Used by apps/api and apps/worker only. Optional in development: without it,
# readiness reports the database as "not_configured".
# Host ports of the compose services (compose.yaml). Change one only if it is
# taken or reserved on your machine (common on Windows for 5432), and update
# the matching URLs in this file: DATABASE_URL/TEST_DATABASE_URL (Postgres),
# S3_ENDPOINT, SMTP_URL and ORIGINOS_DEV_MAILBOX_URL.
POSTGRES_HOST_PORT=5432
S3_HOST_PORT=8333
SMTP_HOST_PORT=1025
MAILPIT_HOST_PORT=8025
DATABASE_URL=postgres://originos:originos-local-only@127.0.0.1:5432/originos
# Separate database for tests that write data (created by infra/local/postgres-init).
TEST_DATABASE_URL=postgres://originos:originos-local-only@127.0.0.1:5432/originos_test

# --- Object storage (compose service "object-storage", S3-compatible) ----
# Not read by any code until Phase 07 (ingestion). Listed so the emulator's
# local credentials are documented in one place.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=originos-local-access-key
S3_SECRET_ACCESS_KEY=originos-local-only-secret

# --- apps/api ------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
# Browser-facing origin of apps/web. Auth cookies, CSRF origin checks, passkeys
# (relying-party ID = its hostname) and email links all use it. Use localhost,
# not 127.0.0.1: passkeys need a domain name.
ORIGINOS_PUBLIC_URL=http://localhost:3000
# Signs and encrypts auth cookies and 2FA secrets (32+ characters). This value is
# for local development only; production needs its own secret (docs/SECRETS.md).
BETTER_AUTH_SECRET=originos-local-only-auth-secret-change-me-in-prod
# Outbound email. Locally this is Mailpit from compose (http://127.0.0.1:8025).
# Unset = email delivery "not configured": sign-up and invitations say so.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="OriginOS <no-reply@localhost>"
# Per-IP limits on sign-in, sign-up and other auth endpoints. "off" only for
# local browser test runs (every request comes from 127.0.0.1); refused in production.
AUTH_RATE_LIMIT=on

# --- apps/web (server-side only; never sent to the browser) --------------
ORIGINOS_API_URL=http://127.0.0.1:4000
# The web app also reads ORIGINOS_PUBLIC_URL (above) and sends it as Origin on server-side API calls.
# Link to the local mail catcher on "check your email" screens (never shown in production builds).
ORIGINOS_DEV_MAILBOX_URL=http://127.0.0.1:8025
# The /design-system gallery is on outside production; set "true" to show it in a production build.
ORIGINOS_ENABLE_GALLERY=false

# --- apps/worker (health endpoint and outbox dispatch) -------------------
WORKER_HEALTH_PORT=4050
WORKER_HEALTH_HOST=127.0.0.1
# How often the worker polls the outbox (ms, 100-60000). It connects as the
# originos_worker role and only polls once a module registers a consumer.
OUTBOX_POLL_MS=1000

# --- apps/mcp-server -----------------------------------------------------
MCP_PORT=4100
MCP_HOST=127.0.0.1

# --- services/telemetry --------------------------------------------------
TELEMETRY_PORT=4200
TELEMETRY_HOST=127.0.0.1

# --- services/media-validator --------------------------------------------
MEDIA_VALIDATOR_PORT=4300
MEDIA_VALIDATOR_HOST=127.0.0.1

# --- services/ai-worker (Python) -----------------------------------------
# AI gateway endpoint on the API; it does not exist until Phase 15.
# AI_GATEWAY_URL=
