{
  "name": "@originos/authz",
  "version": "0.0.0",
  "private": true,
  "description": "The single OriginOS permission evaluator: roles, resource-scoped grants, explicit deny, agent and service actors. Pure and deterministic; used by the API, worker and MCP server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
